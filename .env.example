CAPTCHA_API_KEY=your_api_key
CAPTCHA_SOLVE_TIMEOUT=300

# Official public demo pages.
RECAPTCHA_V2_TARGET_URL=https://www.google.com/recaptcha/api2/demo
YANDEX_TARGET_URL=https://captcha-api.yandex.ru/demo

# Placeholder URLs: replace these example.com addresses with pages you are authorized to test.
TURNSTILE_TARGET_URL=https://example.com/page_with_cloudflare_turnstile
TURNSTILE_CHALLENGE_TARGET_URL=https://example.com/page_with_cloudflare_challenge
RECAPTCHA_V2_ENTERPRISE_TARGET_URL=https://example.com/page_with_recaptcha_v2_enterprise
RECAPTCHA_V2_CALLBACK_TARGET_URL=https://example.com/page_with_recaptcha_v2_callback
RECAPTCHA_V3_TARGET_URL=https://example.com/page_with_recaptcha_v3
RECAPTCHA_V3_ENTERPRISE_TARGET_URL=https://example.com/page_with_recaptcha_v3_enterprise
GEETEST_V3_TARGET_URL=https://example.com/page_with_geetest_v3
GEETEST_V4_TARGET_URL=https://example.com/page_with_geetest_v4
TENCENT_TARGET_URL=https://example.com/page_with_tencent_captcha

# Page-specific settings required by the reCAPTCHA v2 callback examples.
RECAPTCHA_V2_CALLBACK_NAME=verifyRecaptcha
RECAPTCHA_V2_CALLBACK_SUCCESS_SELECTOR=.captcha-success

# Required only for examples whose filename ends with _proxy.py.
PROXY_TYPE=http
PROXY_ADDRESS=proxy-placeholder.example
PROXY_PORT=8080
PROXY_LOGIN=user
PROXY_PASSWORD=password
