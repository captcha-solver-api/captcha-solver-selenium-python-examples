CAPTCHA_API_KEY=your_api_key
TARGET_URL=https://example.com/captcha

# Optional selectors used by individual examples.
CAPTCHA_SELECTOR=[data-sitekey]
ANSWER_SELECTOR=input[name="captcha-answer"]
SUBMIT_SELECTOR=button[type="submit"]

# reCAPTCHA v3
WEBSITE_KEY=your_website_key
PAGE_ACTION=submit
MIN_SCORE=0.3

# Coordinate captcha
CAPTCHA_INSTRUCTION=Click every traffic light

