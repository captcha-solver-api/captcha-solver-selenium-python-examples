CAPTCHA_API_KEY=your_api_key
CAPTCHA_SOLVE_TIMEOUT=300

# Official public demo pages.
RECAPTCHA_V2_TARGET_URL=https://www.google.com/recaptcha/api2/demo
YANDEX_TARGET_URL=https://smartcaptcha.cloud.yandex.ru/demo

# Placeholder URLs: replace these .example addresses with pages you are authorized to test.
TURNSTILE_TARGET_URL=https://cloudflare-turnstile-placeholder.example/demo
TURNSTILE_CHALLENGE_TARGET_URL=https://cloudflare-challenge-placeholder.example/demo
RECAPTCHA_V2_ENTERPRISE_TARGET_URL=https://google-recaptcha-v2-enterprise-placeholder.example/demo
RECAPTCHA_V2_CALLBACK_TARGET_URL=https://google-recaptcha-v2-callback-placeholder.example/demo
RECAPTCHA_V3_TARGET_URL=https://google-recaptcha-v3-placeholder.example/demo
RECAPTCHA_V3_ENTERPRISE_TARGET_URL=https://google-recaptcha-v3-enterprise-placeholder.example/demo
TENCENT_TARGET_URL=https://tencent-captcha-placeholder.example/demo

# Page-specific settings required by the reCAPTCHA v2 callback examples.
RECAPTCHA_V2_CALLBACK_NAME=verifyRecaptcha
RECAPTCHA_V2_CALLBACK_SUCCESS_SELECTOR=.captcha-success

# Required only for examples whose filename ends with _proxy.py.
PROXY_TYPE=http
PROXY_ADDRESS=proxy-placeholder.example
PROXY_PORT=8080
PROXY_LOGIN=user
PROXY_PASSWORD=password
